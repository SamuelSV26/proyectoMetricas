{
  "name": "automatizacion-metricas-web-uam",
  "version": "1.0.0",
  "description": "Automatización de evaluación de métricas web institucionales con Lighthouse, Cypress y Google Sheets",
  "main": "scheduler.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome --spec \"cypress/e2e/lighthouse.cy.js\"",
    "cypress:run:mobile": "cypress run --browser chrome --spec \"cypress/e2e/lighthouse.cy.js\" --env device=mobile",
    "cypress:run:desktop": "cypress run --browser chrome --spec \"cypress/e2e/lighthouse.cy.js\" --env device=desktop",
    "scheduler": "node scheduler.js",
    "scheduler:now": "node scheduler.js --now",
    "sync:sheets": "node scripts/sync-to-sheets.js"
  },
  "keywords": [
    "cypress",
    "lighthouse",
    "google-sheets",
    "metrics",
    "uam"
  ],
  "author": "Samuel Sanchez & Santiago Cotrini - UAM",
  "license": "ISC",
  "dependencies": {
    "google-auth-library": "^11.3.2",
    "google-spreadsheet": "^5.3.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@cypress-audit/lighthouse": "^1.4.2",
    "cypress": "^13.17.0",
    "lighthouse": "^12.8.2"
  }
}
